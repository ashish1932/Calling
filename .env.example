# Punjab Voice AI Assistant — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ── Backend Server ────────────────────────────────────────────
PORT=5001
MONGODB_URI=mongodb://mongodb:27017/punjabvoice

# ── AI / Speech APIs ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvamai_api_key_here

# ── LiveKit (WebRTC) ─────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.com

# ── Firebase (Push Notifications) ────────────────────────────
FIREBASE_CREDENTIALS_PATH=/app/google-services.json

# ── TURN Server (optional) ────────────────────────────────────
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Cloudflare Tunnel ─────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Ngrok (local dev only) ────────────────────────────────────
NGROK_URL=

# ── Seed Credentials (Default login passwords) ─────────────────
# SPO: Sh. Gurinder Bhullar IAS (spo@cbm.gov.in)
SEED_PASSWORD_SPO=CBM@SPOwner24

# Supervisor: Dr. Rajdeep Singh (supervisor@cbm.gov.in)
SEED_PASSWORD_SUPERVISOR=CBM@Supervisor24

# Counsellors: (counsellor_amritsar@cbm.gov.in, counsellor_jalandhar@cbm.gov.in, counsellor_ludhiana@cbm.gov.in, counsellor_patiala@cbm.gov.in)
SEED_PASSWORD_COUNSELLOR=CBM@Counsellor24

# DDRC Admins: (ddrc_amritsar@cbm.gov.in, ddrc_jalandhar@cbm.gov.in, ddrc_ludhiana@cbm.gov.in, ddrc_patiala@cbm.gov.in)
SEED_PASSWORD_DDRC=CBM@DDRC24

# DITSU: Er. Navneet Sharma (ditsu@cbm.gov.in)
SEED_PASSWORD_DITSU=CBM@DITSU24

# OPD Staff: OPD Coordinator (opd@cbm.gov.in)
SEED_PASSWORD_OPD=CBM@OPD24

# ── Upload Configuration ───────────────────────────────────────
# Optional: directory to save recorded audio sessions (defaults to relative frontend path)
UPLOAD_DIR=
